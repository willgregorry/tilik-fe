# ========================================================
# Tilik Android Environment Configuration Example
# ========================================================
# Salin file ini menjadi .env di root project atau di folder tilik/
# File .env asli Anda TIDAK AKAN di-commit karena dilindungi oleh .gitignore.

# Base URL untuk API Backend Tilik
# - Jika menggunakan Android Emulator: gunakan http://10.0.2.2:8000/
# - Jika menggunakan HP Fisik (USB Debugging / Wi-Fi): gunakan IP laptop Anda, misal http://192.168.1.10:8000/
TILIK_BASE_URL=https://6rlfv87r-8000.asse.devtunnels.ms/

# Sectors Financial API Key (https://sectors.app)
# Masukkan API Key Anda di sini jika menghubungkan langsung ke Sectors API
SECTORS_API_KEY=your_sectors_api_key_here

# Google Gemini API Key (Opsional jika menggunakan analisis LLM langsung)
GEMINI_API_KEY=your_gemini_api_key_here

# Mode Lingkungan (development / staging / production)
ENVIRONMENT=development

# Google OAuth Web Client ID (Backend Server Client ID for Audience)
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here
